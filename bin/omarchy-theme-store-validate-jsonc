#!/usr/bin/env python3
"""Validate that a file is well-formed JSONC (full-line // comments and
trailing commas tolerated, matching omarchy-menu.jsonc's own dialect).

Exit 0 if the file parses; exit 1 otherwise, with a reason on stderr. Used
as a pre-write gate before replacing omarchy-menu.jsonc, so a malformed
result never lands on disk — the caller keeps whatever it had instead.
"""

import json
import re
import sys

MAX_BYTES = 1024 * 1024


def strip_jsonc(text):
    # Only full-line comments (after optional leading whitespace) are
    # stripped, matching the style the shipped omarchy-menu.jsonc actually
    # uses — never a blind "//" strip, which would mangle a "https://" URL
    # sitting inside a string value.
    text = re.sub(r"(?m)^[ \t]*//.*$", "", text)
    # Trailing commas before a closing brace/bracket are the other piece of
    # the JSONC dialect this file relies on.
    text = re.sub(r",(\s*[}\]])", r"\1", text)
    return text


def main():
    if len(sys.argv) != 2:
        print("usage: omarchy-theme-store-validate-jsonc <file>", file=sys.stderr)
        return 2

    path = sys.argv[1]
    try:
        with open(path, "rb") as f:
            data = f.read(MAX_BYTES + 1)
    except OSError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    if len(data) > MAX_BYTES:
        print("error: file exceeds size limit", file=sys.stderr)
        return 1

    try:
        json.loads(strip_jsonc(data.decode("utf-8")))
    except (UnicodeDecodeError, ValueError) as exc:
        print(f"error: invalid JSONC: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
