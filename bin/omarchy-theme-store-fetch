#!/usr/bin/env python3
"""Fetch and cache the Omarchy community theme catalog from omarchy.org/themes/.

Prints a JSON array of {slug, name, repoUrl, thumbnailPath} to stdout, where
thumbnailPath is a local file already cached on disk. Caches the parsed
catalog and thumbnails under ~/.cache/omarchy/theme-store/ and reuses them
until OMARCHY_THEME_STORE_TTL seconds have passed (default 24h) or --force
is passed. If a refresh fails but a cache exists (even stale), the stale
cache is served rather than leaving the caller with nothing.

Everything below the source page is untrusted: the HTML, the thumbnail
bytes, and the on-disk cache are all bounded, host-restricted, and read
through verified, non-symlinked paths, because this output feeds directly
into a long-lived QML process (see ThemeStore.qml / ThemeStoreModel.js).
"""

import errno
import html
import json
import os
import re
import sys
import tempfile
import time
import urllib.error
import urllib.request
from urllib.parse import urlsplit

SOURCE_URL = "https://omarchy.org/themes/"
SOURCE_ORIGIN = "https://omarchy.org"
ALLOWED_HOST = "omarchy.org"
CACHE_DIR = os.path.join(os.path.expanduser("~"), ".cache", "omarchy", "theme-store")
THUMB_DIR = os.path.join(CACHE_DIR, "thumbs")
CATALOG_PATH = os.path.join(CACHE_DIR, "catalog.json")
TTL_SECONDS = int(os.environ.get("OMARCHY_THEME_STORE_TTL", 24 * 60 * 60))
USER_AGENT = "omarchy-theme-store/0.1 (+https://github.com/stizzy-98/Omarchy-Theme-Store)"

# ---- bounds -----------------------------------------------------------
# Every one of these exists because the data on the other side of the
# fetch is not trusted: a compromised or misbehaving source page should
# degrade this plugin, never let it hang, exhaust memory, or hand the
# QML host something unbounded.
MAX_PAGE_BYTES = 5 * 1024 * 1024       # catalog HTML page
MAX_THUMB_BYTES = 2 * 1024 * 1024      # a single thumbnail
MAX_CACHE_FILE_BYTES = 8 * 1024 * 1024  # our own catalog.json cache file
MAX_ITEMS = 300                        # catalog entries kept
MAX_FIELD_LEN = 300                    # slug/name/repoUrl/url string length
MAX_REDIRECTS = 5
MAX_IMAGE_DIMENSION = 4096             # per-axis pixel cap
MAX_IMAGE_PIXELS = 4096 * 4096
MAX_TOTAL_SECONDS = 45                 # whole-run deadline for refresh()
REQUEST_TIMEOUT = 15

_deadline = None


def fail(msg):
    print(f"error: {msg}", file=sys.stderr)


def time_left():
    if _deadline is None:
        return REQUEST_TIMEOUT
    return max(0.5, _deadline - time.monotonic())


# ---- verified, non-symlinked cache directories -------------------------

def ensure_verified_dir(path):
    """Create/verify a private directory this process fully controls.

    Refuses to proceed if the path exists but is a symlink or not a
    directory, rather than silently following it somewhere unexpected.
    """
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
    except OSError as exc:
        if exc.errno != errno.EEXIST:
            raise
    if not os.path.isdir(path) or os.path.islink(path):
        raise RuntimeError(f"refusing to use non-directory/symlinked cache path: {path}")
    return path


def open_nofollow_bounded(path, max_bytes):
    """Open a regular file for reading without following a symlink, and
    read at most max_bytes+1 (so callers can detect truncation)."""
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    try:
        st = os.fstat(fd)
        if not os.path.stat.S_ISREG(st.st_mode):
            raise RuntimeError(f"refusing to read non-regular file: {path}")
        with os.fdopen(fd, "rb") as f:
            fd = None
            return f.read(max_bytes + 1)
    finally:
        if fd is not None:
            os.close(fd)


def atomic_write_bytes(dest_dir, dest_name, data):
    """Write data into dest_dir/dest_name via an unpredictable temp name
    and an exclusive create, then atomically rename it into place."""
    fd, tmp_path = tempfile.mkstemp(prefix=".tmp-", dir=dest_dir)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.replace(tmp_path, os.path.join(dest_dir, dest_name))
    except BaseException:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


# ---- bounded, host-restricted HTTP fetch -------------------------------

class _BoundedRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Only follows https redirects that stay on ALLOWED_HOST, and caps
    the number of hops. Anything else is refused rather than followed."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        parts = urlsplit(newurl)
        if parts.scheme != "https" or parts.hostname != ALLOWED_HOST:
            raise urllib.error.URLError(
                f"refusing redirect to untrusted target: {newurl}"
            )
        hops = getattr(req, "_theme_store_redirects", 0) + 1
        if hops > MAX_REDIRECTS:
            raise urllib.error.URLError("too many redirects")
        new_req = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new_req is not None:
            new_req._theme_store_redirects = hops
        return new_req


_opener = urllib.request.build_opener(_BoundedRedirectHandler)


def fetch_bounded(url, max_bytes, timeout=REQUEST_TIMEOUT):
    """GET url and return at most max_bytes of body, enforcing an https +
    ALLOWED_HOST policy on the initial request and every redirect hop."""
    parts = urlsplit(url)
    if parts.scheme != "https" or parts.hostname != ALLOWED_HOST:
        raise ValueError(f"refusing to fetch untrusted URL: {url}")

    req = urllib.request.Request(
        url,
        headers={"User-Agent": USER_AGENT, "Accept-Encoding": "identity"},
    )
    req._theme_store_redirects = 0
    with _opener.open(req, timeout=min(timeout, time_left())) as resp:
        length_header = resp.headers.get("Content-Length")
        if length_header is not None:
            try:
                if int(length_header) > max_bytes:
                    raise ValueError(f"declared response size exceeds limit for {url}")
            except (TypeError, ValueError):
                pass

        chunks = []
        total = 0
        chunk_size = 65536
        while True:
            chunk = resp.read(chunk_size)
            if not chunk:
                break
            total += len(chunk)
            if total > max_bytes:
                raise ValueError(f"response body exceeds {max_bytes} bytes: {url}")
            chunks.append(chunk)
        return b"".join(chunks)


# ---- image sniffing (no PIL available; stdlib-only header parsing) -----

def sniff_image_dimensions(data):
    """Return (format, width, height) for a supported image, or None if
    the bytes are not a recognized, safely-sized image. This exists so a
    malicious thumbnail can't reach the QML Image loader with dimensions
    designed to blow up decoded memory."""
    if len(data) >= 24 and data[:8] == b"\x89PNG\r\n\x1a\n" and data[12:16] == b"IHDR":
        w = int.from_bytes(data[16:20], "big")
        h = int.from_bytes(data[20:24], "big")
        return ("png", w, h)

    if len(data) >= 6 and data[:6] in (b"GIF87a", b"GIF89a"):
        w = int.from_bytes(data[6:8], "little")
        h = int.from_bytes(data[8:10], "little")
        return ("gif", w, h)

    if len(data) >= 4 and data[:2] == b"\xff\xd8":
        i = 2
        n = len(data)
        while i + 9 <= n:
            if data[i] != 0xFF:
                i += 1
                continue
            marker = data[i + 1]
            if marker in (0xD8, 0xD9):
                i += 2
                continue
            if 0xD0 <= marker <= 0xD7:
                i += 2
                continue
            if i + 4 > n:
                break
            seg_len = int.from_bytes(data[i + 2:i + 4], "big")
            is_sof = marker in (
                0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7,
                0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF,
            )
            if is_sof and i + 9 <= n:
                h = int.from_bytes(data[i + 5:i + 7], "big")
                w = int.from_bytes(data[i + 7:i + 9], "big")
                return ("jpeg", w, h)
            i += 2 + seg_len
        return None

    if len(data) >= 30 and data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        chunk = data[12:16]
        if chunk == b"VP8 " and len(data) >= 30:
            w = int.from_bytes(data[26:28], "little") & 0x3FFF
            h = int.from_bytes(data[28:30], "little") & 0x3FFF
            return ("webp", w, h)
        if chunk == b"VP8L" and len(data) >= 25:
            bits = int.from_bytes(data[21:25], "little")
            w = (bits & 0x3FFF) + 1
            h = ((bits >> 14) & 0x3FFF) + 1
            return ("webp", w, h)
        if chunk == b"VP8X" and len(data) >= 30:
            w = int.from_bytes(data[24:27], "little") + 1
            h = int.from_bytes(data[27:30], "little") + 1
            return ("webp", w, h)
        return None

    return None


def is_safe_image(data):
    dims = sniff_image_dimensions(data)
    if dims is None:
        return False
    _, w, h = dims
    if w <= 0 or h <= 0:
        return False
    if w > MAX_IMAGE_DIMENSION or h > MAX_IMAGE_DIMENSION:
        return False
    if w * h > MAX_IMAGE_PIXELS:
        return False
    return True


# ---- catalog parsing -----------------------------------------------------

# Matches the exact static markup omarchy.org/themes/ ships today:
#   <figure class="themes__theme">
#     <a href="REPO"><img src="/assets/themes/SLUG.webp" ...></a>
#     <figcaption><a href="REPO">NAME</a></figcaption>
#   </figure>
FIGURE_RE = re.compile(
    r'<figure class="themes__theme">\s*'
    r'<a href="(?P<repo>[^"]+)"><img src="(?P<thumb>[^"]+)"[^>]*></a>\s*'
    r'<figcaption><a href="[^"]+">(?P<name>[^<]+)</a></figcaption>\s*'
    r'</figure>',
    re.DOTALL,
)

SLUG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
REPO_URL_RE = re.compile(
    r"^https://github\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})"
    r"/[A-Za-z0-9._-]{1,100}(?:\.git)?/?$"
)


def clip(s, max_len=MAX_FIELD_LEN):
    return s[:max_len]


def parse_catalog(page_html):
    entries = []
    for m in FIGURE_RE.finditer(page_html):
        if len(entries) >= MAX_ITEMS:
            break

        thumb = clip(m.group("thumb"))
        thumb_url = thumb if thumb.startswith("http") else (SOURCE_ORIGIN + thumb)
        thumb_parts = urlsplit(thumb_url)
        if thumb_parts.scheme != "https" or thumb_parts.hostname != ALLOWED_HOST:
            # Only ever fetch thumbnails from the same trusted origin as the
            # catalog page itself; drop anything that points elsewhere.
            continue

        raw_slug = os.path.splitext(os.path.basename(thumb_parts.path))[0]
        slug = clip(raw_slug, 64)
        if not SLUG_RE.match(slug):
            continue

        repo_url = clip(html.unescape(m.group("repo")).strip())
        name = clip(html.unescape(m.group("name")).strip())
        if not name or not repo_url:
            continue

        entries.append({
            "slug": slug,
            "name": name,
            "repoUrl": repo_url,
            "thumbnailUrl": thumb_url,
        })
    return entries


def ensure_thumbnail(entry):
    slug = entry["slug"]
    ext = os.path.splitext(urlsplit(entry["thumbnailUrl"]).path)[1].lower()
    if ext not in (".png", ".jpg", ".jpeg", ".gif", ".webp"):
        ext = ".img"
    dest_name = slug + ext
    dest = os.path.join(THUMB_DIR, dest_name)

    # Path containment: dest must resolve inside the verified thumbs dir.
    if os.path.dirname(os.path.realpath(dest)) != os.path.realpath(THUMB_DIR):
        return ""

    if os.path.exists(dest) and not os.path.islink(dest):
        return dest

    if time_left() <= 1:
        # Global deadline reached: stop fetching more thumbnails rather
        # than risk running unbounded.
        return ""

    try:
        data = fetch_bounded(entry["thumbnailUrl"], MAX_THUMB_BYTES)
        if not is_safe_image(data):
            print(f"warn: rejected thumbnail for {slug} (unrecognized/oversized image)", file=sys.stderr)
            return ""
        atomic_write_bytes(THUMB_DIR, dest_name, data)
        return dest
    except (urllib.error.URLError, ValueError, OSError) as exc:
        print(f"warn: failed to cache thumbnail for {slug}: {exc}", file=sys.stderr)
        return ""


def refresh():
    global _deadline
    _deadline = time.monotonic() + MAX_TOTAL_SECONDS

    ensure_verified_dir(CACHE_DIR)
    ensure_verified_dir(THUMB_DIR)

    page = fetch_bounded(SOURCE_URL, MAX_PAGE_BYTES).decode("utf-8", "replace")
    entries = parse_catalog(page)
    if not entries:
        raise RuntimeError("no themes parsed from omarchy.org/themes/ (page layout may have changed)")

    catalog = []
    for entry in entries:
        catalog.append({
            "slug": entry["slug"],
            "name": entry["name"],
            "repoUrl": entry["repoUrl"],
            "thumbnailPath": ensure_thumbnail(entry),
        })

    catalog.sort(key=lambda t: t["name"].lower())

    payload = json.dumps({"fetchedAt": int(time.time()), "themes": catalog}).encode("utf-8")
    atomic_write_bytes(CACHE_DIR, "catalog.json", payload)
    return catalog


def load_cached():
    data = open_nofollow_bounded(CATALOG_PATH, MAX_CACHE_FILE_BYTES)
    if len(data) > MAX_CACHE_FILE_BYTES:
        raise ValueError("cached catalog exceeds size limit")
    parsed = json.loads(data.decode("utf-8"))
    themes = parsed.get("themes", [])
    if not isinstance(themes, list):
        themes = []
    return themes[:MAX_ITEMS], parsed.get("fetchedAt", 0)


def main():
    force = "--force" in sys.argv[1:]
    ensure_verified_dir(CACHE_DIR)

    if not force and os.path.exists(CATALOG_PATH):
        try:
            themes, fetched_at = load_cached()
            if themes and (time.time() - fetched_at) < TTL_SECONDS:
                print(json.dumps(themes))
                return
        except (OSError, ValueError):
            pass

    try:
        themes = refresh()
    except Exception as exc:
        if os.path.exists(CATALOG_PATH):
            try:
                themes, _ = load_cached()
                print(f"warn: refresh failed ({exc}); serving cached catalog", file=sys.stderr)
                print(json.dumps(themes))
                return
            except (OSError, ValueError):
                pass
        fail(str(exc))
        print("[]")
        sys.exit(1)

    print(json.dumps(themes))


if __name__ == "__main__":
    main()
